{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@ant/contracts": ["./packages/contracts/src/index.ts"],
      "@ant/core": ["./packages/core/src/index.ts"],
      "@ant/app": ["./packages/app/src/index.ts"],
      "@ant/provider-deepseek": ["./packages/provider-deepseek/src/index.ts"],
      "@ant/session-jsonl": ["./packages/session-jsonl/src/index.ts"],
      "@ant/tools-coding": ["./packages/tools-coding/src/index.ts"],
      "@ant/frontend-terminal": ["./packages/frontend-terminal/src/index.ts"]
    }
  },
  "include": ["./packages/*/src/**/*.ts", "test/**/*.ts"]
}
