{
  "name": "ant-workspace",
  "version": "0.5.24",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx packages/cli/src/main.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -b && npm run bundle:cli",
    "bundle:cli": "esbuild packages/cli/src/main.ts --bundle --platform=node --format=esm --target=node20 --external:highlight.js --external:marked --external:minimatch --external:string-width --external:win32-api --outfile=packages/cli/dist/main.js --sourcemap",
    "start": "node --env-file-if-exists=.env.local packages/cli/dist/main.js",
    "pack:cli": "npm pack --workspace ant",
    "check": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.research.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration",
    "eval": "node --env-file-if-exists=.env.local --import tsx research/evaluation/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
